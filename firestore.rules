rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Returns true if the current user has a claimed member slot in this group.
    // Backed by the /claimedUserIds/{uid} subcollection — an index maintained by
    // firebaseService on every claim/leave/delete operation.
    function isGroupMember(groupId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/groups/$(groupId)/claimedUserIds/$(request.auth.uid));
    }

    // Admins metadata
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if false;
      allow write: if false; // Only write manually in Firebase console
    }

    // User Settings
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Currency settings validation. Codes are free-form, max 4 characters —
    // string.size() in rules counts UTF-8 bytes, so 4 CJK chars (e.g. "日圓")
    // can be up to 12 bytes; the client enforces the 4-character limit.
    // Per-element map validation on lists is impractical in rules: the size cap
    // plus client-side validation and the settlement fallback to rate 1 make
    // malformed entries harmless.
    function hasValidCurrencyFields(data) {
      return (!('defaultCurrency' in data)
          || (data.defaultCurrency is string
              && data.defaultCurrency.size() >= 1
              && data.defaultCurrency.size() <= 12))
        && (!('currencies' in data)
          || (data.currencies is list
              && data.currencies.size() <= 20));
    }

    // Join-token lookup — /joinIds/{token} → { groupId }.
    // The token is the secret carried by an invite link. Keying the lookup by
    // token lets the client resolve /join/:joinId without any ability to list
    // or query the groups collection (see the groups list rule below).
    match /joinIds/{token} {
      // Resolving requires possession of the token (it's the document ID).
      allow get: if isAuthenticated();
      // Never enumerable — a list would leak every group's invite token.
      allow list: if isAdmin();
      // Only the group's host can publish a mapping, and only for the token that
      // equals the group's own joinId — so a token can never be pointed at a
      // group it doesn't belong to. getAfter() covers both the createGroup batch
      // (group + mapping written atomically) and the lazy backfill for groups
      // that predate this index.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['groupId'])
        && request.resource.data.groupId is string
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.joinId == token;
      allow update: if false;
      // Host removes the mapping when deleting the group. get() reads the
      // pre-batch state, where the group doc still exists.
      allow delete: if isAdmin() || (
        isAuthenticated()
        && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.createdBy == request.auth.uid
      );
    }

    // Groups
    match /groups/{groupId} {
      // Fetching BY ID is open to any authenticated user so the join and
      // member-selection flows work pre-membership. Listing is what made
      // membership self-grantable (any signed-in user could enumerate every
      // groupId/joinId and then claim a member slot in any group), so it is
      // restricted to owner-scoped queries: the client must include
      // where(createdBy == request.auth.uid) — used by guest-account cleanup —
      // or the query is rejected. A groupId therefore only travels via invite
      // links and acts as the join capability.
      allow get: if isAuthenticated();
      allow list: if isAdmin() || (isAuthenticated() && resource.data.createdBy == request.auth.uid);

      // Creating a group. joinId is optional (legacy groups lack it) but when
      // present must look like a generated invite token.
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50
        && hasValidCurrencyFields(request.resource.data)
        && (!('joinId' in request.resource.data)
            || (request.resource.data.joinId is string
                && request.resource.data.joinId.size() >= 8
                && request.resource.data.joinId.size() <= 24));

      // Only host (creator) or admin can update or delete the group.
      // This includes renaming the group, settling up (setting settledAt/settledBy), and unsettling up (deleting settledAt/settledBy).
      allow update: if isAdmin() || (
        isAuthenticated()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50
        && hasValidCurrencyFields(request.resource.data)
        && (
          // Defense-in-depth: If settling up, ensure settledBy matches the host/auth UID
          (!request.resource.data.keys().hasAll(['settledAt', 'settledBy']) || request.resource.data.settledBy == request.auth.uid)
        )
        // Defense-in-depth: Currency settings cannot be modified while group is settled
        && (
          !('settledAt' in resource.data)
          || !('settledAt' in request.resource.data)
          || (
            (!('defaultCurrency' in request.resource.data) || request.resource.data.defaultCurrency == resource.data.defaultCurrency)
            && (!('currencies' in request.resource.data) || request.resource.data.currencies == resource.data.currencies)
          )
        )
        // joinId is immutable once set (and can't be removed). Otherwise a host
        // could re-point their group's joinId at a token they saw elsewhere and
        // publish a /joinIds mapping that hijacks someone else's invite link.
        // A missing joinId may be backfilled once with a valid token.
        && (
          ('joinId' in resource.data && request.resource.data.joinId == resource.data.joinId)
          || (!('joinId' in resource.data) && !('joinId' in request.resource.data))
          || (!('joinId' in resource.data)
              && request.resource.data.joinId is string
              && request.resource.data.joinId.size() >= 8
              && request.resource.data.joinId.size() <= 24)
        )
      );

      allow delete: if isAdmin() || (
        isAuthenticated()
        && resource.data.createdBy == request.auth.uid
      );

      // Membership index — document ID is the Firebase Auth UID.
      // Used by isGroupMember() to gate expense and settlement access.
      match /claimedUserIds/{uid} {
        // A user may read their own membership marker (only reveals their own
        // memberId) so the client can skip a redundant backfill write when the
        // entry already exists. exists() in rules works regardless of this.
        allow get: if uid == request.auth.uid;
        allow list: if isAdmin();
        // User can create/update their own entry when they have (or are acquiring in
        // this same batch) a member slot with userId == request.auth.uid.
        // getAfter() reads the projected post-batch state, allowing atomic
        // claim + index writes in a single writeBatch.
        allow create: if uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.memberId)).data.userId == request.auth.uid;
        allow update: if uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.memberId)).data.userId == request.auth.uid;
        // User can remove their own entry (leave), the host can remove any entry
        // (member deletion), or an admin can purge the index (backoffice cleanup).
        allow delete: if isAdmin() || (
          isAuthenticated() && (
            uid == request.auth.uid
            || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
          )
        );
      }

      // Members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated();

        // Host or admin can create members, or a user can claim a member.
        // getAfter(): createGroup writes the group doc and its host member
        // (isHost: true) in one atomic batch, and get() would read the
        // pre-batch state where the group doesn't exist yet — the creator
        // branch must see the projected post-batch group. No privilege is
        // gained: becoming createdBy of that post-batch group requires either
        // already owning it or creating it in this batch, and the group
        // create rule pins createdBy to request.auth.uid.
        // Client caps member names at 20 characters; string.size() in rules
        // counts UTF-8 bytes, so 20 CJK chars are up to 80 bytes.
        allow create: if isAdmin() || (
          isAuthenticated()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && (getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
              || (request.resource.data.userId == request.auth.uid
                  && (!('isHost' in request.resource.data) || request.resource.data.isHost == false)))
        );

        // Host or admin can update any member, or a user can update their own claimed profile
        // Also allow a user to claim an unclaimed member (userId is null).
        // A claimed member may set their userId back to null (leave/unclaim) but not to another user's UID.
        allow update: if isAdmin() || (
          isAuthenticated()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && (get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
              || (resource.data.userId == request.auth.uid
                  && (request.resource.data.userId == request.auth.uid || request.resource.data.userId == null)
                  && (!('isHost' in request.resource.data) || request.resource.data.isHost == resource.data.isHost))
              || (resource.data.userId == null && request.resource.data.userId == request.auth.uid
                  && (!('isHost' in request.resource.data) || request.resource.data.isHost == resource.data.isHost)))
        );

        // Only host or admin can delete members
        allow delete: if isAdmin() || (
          isAuthenticated()
          && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
        );
      }

      // Expenses subcollection — gated on group membership to prevent data leaks
      // and unauthorized writes by users who are not part of this group.
      match /expenses/{expenseId} {
        allow read: if isAdmin() || isGroupMember(groupId);

        // `currency` is optional (legacy expenses lack it); size() counts UTF-8
        // bytes, so the cap is 12 for a 4-character CJK code (see note above).
        allow create: if isGroupMember(groupId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 100
          && (!('currency' in request.resource.data)
              || (request.resource.data.currency is string
                  && request.resource.data.currency.size() >= 1
                  && request.resource.data.currency.size() <= 12));

        allow update: if isGroupMember(groupId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 100
          && (!('currency' in request.resource.data)
              || (request.resource.data.currency is string
                  && request.resource.data.currency.size() >= 1
                  && request.resource.data.currency.size() <= 12));

        allow delete: if isAdmin() || isGroupMember(groupId);
      }

      // Manual settlement records subcollection
      // Each record represents an out-of-band money transfer that one party has
      // confirmed completing (e.g. "Alice paid Bob $50 via Venmo").
      match /settlements/{settlementId} {
        allow read: if isAdmin() || isGroupMember(groupId);

        // Only the payer or receiver can mark a payment complete.
        // The marker must be authenticated as the member referenced by
        // `completedByMemberId`, and that member must be either `from` or `to`.
        allow create: if isGroupMember(groupId)
          && request.resource.data.completedBy == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 1000000
          && request.resource.data.from != request.resource.data.to
          && (request.resource.data.completedByMemberId == request.resource.data.from
              || request.resource.data.completedByMemberId == request.resource.data.to)
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.from))
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.to))
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.completedByMemberId)).data.userId == request.auth.uid;

        // Records are append-only. Use delete + create to "edit".
        allow update: if false;

        // The person who recorded the payment, the group host, or an admin can undo it.
        allow delete: if isAdmin() || (
          isAuthenticated()
          && (resource.data.completedBy == request.auth.uid
              || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid)
        );
      }
    }
  }
}
