rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins metadata
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only write manually in Firebase console
    }

    // User Settings
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Groups
    match /groups/{groupId} {
      // Any authenticated user (including anonymous) can read a group by its ID.
      // Knowing the groupId (shared via link) is the join mechanism.
      allow read: if isAuthenticated();
      
      // Creating a group
      allow create: if isAuthenticated() 
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50;
      
      // Only host (creator) or admin can update or delete the group.
      // This includes renaming the group, settling up (setting settledAt/settledBy), and unsettling up (deleting settledAt/settledBy).
      allow update: if isAdmin() || (
        isAuthenticated()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50
        && (
          // Defense-in-depth: If settling up, ensure settledBy matches the host/auth UID
          (!request.resource.data.keys().hasAll(['settledAt', 'settledBy']) || request.resource.data.settledBy == request.auth.uid)
        )
      );
      
      allow delete: if isAdmin() || (
        isAuthenticated() 
        && resource.data.createdBy == request.auth.uid
      );

      // Members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated();
        
        // Host or admin can create members, or a user can claim a member
        allow create: if isAdmin() || (
          isAuthenticated()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 50
          && (get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
              || request.resource.data.userId == request.auth.uid)
        );
        
        // Host or admin can update any member, or a user can update their own claimed profile
        // Also allow a user to claim an unclaimed member (userId is null).
        // A claimed member may set their userId back to null (leave/unclaim) but not to another user's UID.
        allow update: if isAdmin() || (
          isAuthenticated()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 50
          && (get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
              || (resource.data.userId == request.auth.uid
                  && (request.resource.data.userId == request.auth.uid || request.resource.data.userId == null))
              || (resource.data.userId == null && request.resource.data.userId == request.auth.uid))
        );
              
        // Only host or admin can delete members
        allow delete: if isAdmin() || (
          isAuthenticated() 
          && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
        );
      }

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow read: if isAuthenticated();

        // Any authenticated user (ideally limited to members) can create/edit expenses
        // We validate that the createdBy matches the current member link
        allow create: if isAuthenticated()
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 100;

        allow update: if isAuthenticated()
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 100;

        allow delete: if isAuthenticated();
      }

      // Manual settlement records subcollection
      // Each record represents an out-of-band money transfer that one party has
      // confirmed completing (e.g. "Alice paid Bob $50 via Venmo").
      match /settlements/{settlementId} {
        allow read: if isAuthenticated();

        // Only the payer or receiver can mark a payment complete.
        // The marker must be authenticated as the member referenced by
        // `completedByMemberId`, and that member must be either `from` or `to`.
        allow create: if isAuthenticated()
          && request.resource.data.completedBy == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.from != request.resource.data.to
          && (request.resource.data.completedByMemberId == request.resource.data.from
              || request.resource.data.completedByMemberId == request.resource.data.to)
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.from))
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.to))
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.completedByMemberId)).data.userId == request.auth.uid;

        // Records are append-only. Use delete + create to "edit".
        allow update: if false;

        // The person who recorded the payment, the group host, or an admin can undo it.
        allow delete: if isAdmin() || (
          isAuthenticated()
          && (resource.data.completedBy == request.auth.uid
              || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid)
        );
      }
    }
  }
}
