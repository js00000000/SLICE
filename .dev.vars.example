# Cloudflare Pages Functions local environment variables
# Copy this file to '.dev.vars' and fill in the values.
# DO NOT commit '.dev.vars' to Git.

LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_BOT_USER_ID=your_line_bot_user_id_here
APP_URL=http://localhost:8788

# Firebase Admin Service Account (Used by line-webhook to unbind groups on leave event)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key_pem\n-----END PRIVATE KEY-----\n"
